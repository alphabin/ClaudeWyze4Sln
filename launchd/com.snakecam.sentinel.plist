<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.snakecam.sentinel</string>
	<key>ProgramArguments</key>
	<array>
		<string>__ROOT__/chatbot/.venv/bin/python</string>
		<string>-u</string>
		<string>__ROOT__/chatbot/sentinel.py</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/snakecam-sentinel.log</string>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/snakecam-sentinel.log</string>
	<key>ThrottleInterval</key>
	<integer>10</integer>
</dict>
</plist>
