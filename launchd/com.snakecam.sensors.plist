<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.snakecam.sensors</string>
  <key>ProgramArguments</key><array>
    <string>__HOME__/Applications/SnakeSensors.app/Contents/MacOS/SnakeSensors</string>
  </array>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>15</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/snakecam-sensors.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/snakecam-sensors.log</string>
</dict></plist>
