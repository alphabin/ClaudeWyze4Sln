# ---- Wyze -------------------------------------------------------------
# Your normal Wyze login, plus an API key pair generated at:
#   https://developer-api-console.wyze.com/
# The key pair is what gets around Wyze's 2FA. Both are required.
WYZE_EMAIL=you@example.com
WYZE_PASSWORD=
WYZE_API_ID=
WYZE_API_KEY=

# ---- Camera stream names ---------------------------------------------
# These are your Wyze camera nicknames, lowercased with dashes.
# Run ./discover.sh once the bridge is up to see the exact names.
CAM_HOT=
CAM_COLD=

# ---- Destinations -----------------------------------------------------
# Twitch: Creator Dashboard > Settings > Stream > Primary Stream Key
TWITCH_KEY=
# YouTube: Studio > Go Live > Stream key (fill in after the 24h wait)
YOUTUBE_KEY=

# ---- Look & feel ------------------------------------------------------
LAYOUT=sbs          # sbs = full view of both cams | fill = cropped, no bars
LABEL_HOT="HOT SIDE"
LABEL_COLD="COOL SIDE"
BITRATE=4500k

# ---- Govee sensors (Bluetooth beacon names, from sensors/govee_scan.py) -------
SENSOR_HOT=
SENSOR_COOL=
TEMP_UNIT=F         # F or C
CLEOBOT_LAT=34.05            # weather lookup location for the bot/overlay (city-level)
CLEOBOT_LON=-118.24
CAM_COLD_PATH=lake  # lake = Agora/H.265 (Pan V4), kvs = Kinesis WebRTC (Pan V3 etc.); install.sh sets this

# ---- Chat bot (Twitch) -------------------------------------------------
TWITCH_CLIENT_ID=          # public app id (dev.twitch.tv/console/apps, client type Public)
TWITCH_CHANNEL=            # your channel name
TWITCH_BOT_NICK=           # the account the bot posts as (chatbot/auth.py fills this in)
CLEOBOT_LLM_BACKEND=cli    # cli = the `claude` command on this Mac (your subscription); api = ANTHROPIC_API_KEY; off = kill switch
CLEOBOT_CLI_BIN=/opt/homebrew/bin/claude
CLEOBOT_CLI_MODEL=sonnet   # questions / husbandry / tarot
CLEOBOT_CLI_MODEL_TALK=haiku   # small talk
CLEOBOT_LLM_MODEL=claude-opus-5   # model for the api backend
# ANTHROPIC_API_KEY=       # only for the api backend (chatbot/set-claude-key.sh)
CLEOBOT_COOLDOWN=20
CLEOBOT_LLM_BASE_PER_HOUR=60
CLEOBOT_LLM_PER_VIEWER=15
CLEOBOT_LLM_PER_HOUR=200
CLEOBOT_LLM_PER_DAY=1500
CLEOBOT_LLM_PER_USER_DAY=40
CLEOBOT_LLM_PER_REGULAR_DAY=80
CLEOBOT_AMBIENT_MINUTES=12
CLEOBOT_GREET=1
CLEOBOT_FOLLOW_THANKS=1
CLEOBOT_PROACTIVE=1
CLEOBOT_AI_FIRST=1
CLEOBOT_VISION=1
CLEOBOT_CLIPS=1
CLEOBOT_RIP_FOLLOW_GOAL=25
CLEOBOT_RIP_SUB_GOAL=25
CLEOBOT_VOICE=Moira          # macOS say voice she speaks readings/fortunes/poems with (say -v ?); CLEOBOT_VOICE_ON=0 mutes
CLEOBOT_VOICE_RATE=145
CLEOBOT_PIPER_VOICE=en_GB-alba-medium   # see tts/README.md
